# Копия: cp .env.example .env  →  заполнить свои значения

# ── Роутер (OmniRoute) ──
# Публичный URL (если есть домен — указать его, иначе адрес VPS)
PUBLIC_BASE_URL=http://localhost:20128
# Начальный пароль дашборда (СМЕНИТЬ!)
INITIAL_PASSWORD=CHANGEME
# Секреты (сгенерировать: openssl rand -hex 32)
JWT_SECRET=change-me
API_KEY_SECRET=change-me
STORAGE_ENCRYPTION_KEY=change-me
# Порты наружу (20128 — дашборд+API, 20129 — API, 20132 — live)
DASHBOARD_PORT=20128
API_PORT=20129
LIVE_WS_PORT=20132
# Авторизация: true — требуем API-ключ для запросов, false — открыто
REQUIRE_API_KEY=false
# CORS для веб-интерфейса (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Код-агент (OpenHands) ──
# Модель через роутер (бесплатная non-streaming)
AGENT_MODEL=oc/deepseek-v4-flash-free
# Базовый URL роутера изнутри сети compose
ROUTER_INTERNAL_URL=http://router:20128
# Лимит итераций агента
AGENT_MAX_ITERATIONS=50
# API-ключ, если REQUIRE_API_KEY=true — иначе любая непустая строка
ROUTER_API_KEY=any-nonempty-value
